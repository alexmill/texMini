#!/usr/bin/env bash
set -euo pipefail

print_help() {
  cat <<'EOF'
Usage: texmini [install-tinytex] [--engine pdflatex|lualatex|xelatex|latexmk] [OPTIONS] [document.tex] [refs.bib ...]

Compile a LaTeX document, detect bibliography files, and clean auxiliary files after successful builds.

Options:
  --engine ENGINE   Select pdflatex, lualatex, xelatex, or latexmk.
  --no-clean        Keep auxiliary files after a successful build.
  --no-install      Disable TinyTeX package autoinstall.
  --version         Print the texMini version.
  -pvc              Pass latexmk continuous-preview mode and disable cleanup.

Advanced:
  --backend BACKEND Select auto, direct, latexmk, or tinytex.

All other arguments are passed through to latexmk.
EOF
}

if [ "$#" -eq 1 ]; then
  case "$1" in
    --version)
      echo "0.1.0"
      exit 0
      ;;
    --help|-h)
      print_help
      exit 0
      ;;
  esac
fi

script="${BASH_SOURCE[0]}"
while [ -L "$script" ]; do
  script_dir="$(CDPATH= cd -- "$(dirname -- "$script")" && pwd)"
  target="$(readlink "$script")"
  case "$target" in
    /*) script="$target" ;;
    *) script="$script_dir/$target" ;;
  esac
done

root="$(CDPATH= cd -- "$(dirname -- "$script")/.." && pwd)"
python="python3"
python_paths=( "$root/src" )

if [ ! -d "${python_paths[0]}" ]; then
  site_packages=( "$root"/lib/python*/site-packages )
  python_paths=( "${site_packages[0]}" )
  python="$root/bin/python3"

  if [ ! -d "${python_paths[0]}/texmini" ]; then
    for pth_file in "${python_paths[0]}"/*.pth; do
      [ -f "$pth_file" ] || continue
      while IFS= read -r pth_path || [ -n "$pth_path" ]; do
        case "$pth_path" in
          ""|\#*|import*) continue ;;
          /*) candidate="$pth_path" ;;
          *) candidate="${python_paths[0]}/$pth_path" ;;
        esac
        [ -d "$candidate" ] && python_paths+=( "$candidate" )
      done < "$pth_file"
    done
  fi
fi

python_path="$(IFS=:; echo "${python_paths[*]}")"
export PYTHONPATH="$python_path${PYTHONPATH:+:$PYTHONPATH}"
exec "$python" -S -m texmini.cli "$@"
